{
    "name": "iscosta77/upload",
    "description": "Upload — upload completo para PHP sem framework: validacao (hermes/validators), processamento de imagem (hermes/crop-image), nome seguro e registro no banco (hermes_uploads) via iscos/voodoo-2026.",
    "type": "library",
    "license": "MIT",
    "keywords": ["upload", "file", "image", "validation", "webp", "php"],
    "authors": [
        {"name": "Hermes Agent (Nous Research)", "role": "creator and maintainer"},
        {"name": "Ildefonso Costa", "email": "iscosta77@hotmail.com", "role": "publisher"}
    ],
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "iscos/voodoo-2026": "^1.0",
        "iscosta77/validators": "^1.0",
        "hermes/crop-image": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../hermes-validators",
            "options": {"versions": {"iscosta77/validators": "1.0.0"}}
        },
        {
            "type": "path",
            "url": "../hermes-crop-image",
            "options": {"versions": {"hermes/crop-image": "1.0.0"}}
        }
    ],
    "autoload": {
        "psr-4": {
            "Hermes\\Upload\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hermes\\Upload\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox"
    },
    "config": {
        "sort-packages": true
    }
}
